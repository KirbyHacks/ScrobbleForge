# Last.fm API credentials (https://www.last.fm/api/account/create)
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_API_SECRET=your_lastfm_api_secret
LASTFM_USERNAME=your_lastfm_username

# Permanent Last.fm session key (generate via 'python auth_helper.py')
LASTFM_SESSION_KEY=

# Optional legacy password fallback
LASTFM_PASSWORD=

# music source configuration: playlist, album, or single track URL.
# comma-separate for multiple sources. repeated entries are preserved for replay weighting.
# currently supported providers: Spotify.
# generic source variable (takes precedence over legacy SPOTIFY_* variables):
MUSIC_SOURCES=https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M

# legacy Spotify source fallback (used if MUSIC_SOURCES is unset or empty):
# SPOTIFY_PLAYLIST_URL=https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M
# SPOTIFY_TRACK_URL=
# SPOTIFY_URL=

# Optional: Spotify Developer API keys (only if using developer apps)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Scrobble mode: realistic | max_limit | custom_interval
SCROBBLE_MODE=realistic

# Scrobble interval in seconds when SCROBBLE_MODE=custom_interval
CUSTOM_INTERVAL_SECONDS=60

# Playback controls
SHUFFLE=true
LOOP=true

# Rolling 24-hour scrobble safety ceiling (Last.fm daily hard limit is 2,800)
MAX_DAILY_SCROBBLES=2750

# Broadcast "Now Playing" to Last.fm in realistic mode
UPDATE_NOW_PLAYING=true

# Randomized pause range in seconds between tracks (realistic mode)
INTER_TRACK_PAUSE_MIN=1.0
INTER_TRACK_PAUSE_MAX=4.0

# hours between automatic source refreshes (takes precedence over SPOTIFY_REFRESH_INTERVAL_HOURS)
SOURCES_REFRESH_INTERVAL_HOURS=12
# legacy Spotify refresh fallback (used if SOURCES_REFRESH_INTERVAL_HOURS is unset):
# SPOTIFY_REFRESH_INTERVAL_HOURS=12

# Storage location for SQLite database and track cache
DATA_DIR=./data

# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
